# Docker 环境变量（供 docker-compose 使用）
# 复制此文件为 .env 并填入真实值

PORT=3000
NODE_ENV=production

# SQLite 数据目录（容器内路径，无需修改）
DATABASE_URL=file:/data/dev.db

# Redis（容器间用服务名通信）
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# DeepSeek
DEEPSEEK_API_KEY=sk-6171137650444e2f87763ceb44782fb2
DEEPSEEK_BASE_URL=https://api.deepseek.com
